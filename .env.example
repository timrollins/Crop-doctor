# Gemma provider (required for live AI advice)
LLM_PROVIDER=google
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gemma-model-id-from-ai-studio
LLM_FALLBACK_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_KEY=
LLM_FALLBACK_MODEL=

# Speech-to-text: generic HTTP service or experimental Gemma audio
STT_PROVIDER=generic
STT_API_URL=
STT_API_KEY=

# Text-to-speech service
TTS_API_URL=
TTS_API_KEY=

# Optional runtime settings
KNOWLEDGE_DIR=knowledge
AUDIO_DIR=backend/audio_out
CORS_ORIGINS=*
RESPONSE_CACHE_SECONDS=0
MAX_IMAGE_SIDE=768
MAX_UPLOAD_MB=10
